<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.spencer.mcp-workshop-watchdog</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/spencer/repos/mcp-server/deploy/launchd/run_watchdog.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/spencer/repos/mcp-server</string>

    <key>RunAtLoad</key>
    <false/>

    <key>StartInterval</key>
    <integer>60</integer>

    <key>StandardOutPath</key>
    <string>/Users/spencer/Library/Logs/mcp-workshop-stack/watchdog.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/spencer/Library/Logs/mcp-workshop-stack/watchdog.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/Users/spencer/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>HOME</key>
        <string>/Users/spencer</string>
        <key>DOCKER_HOST</key>
        <string>unix:///var/run/docker.sock</string>
    </dict>

    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
