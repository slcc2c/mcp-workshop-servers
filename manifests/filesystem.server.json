{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-10-17/server.schema.json",
  "name": "io.github.slcc2c/mcp-filesystem",
  "title": "MCP Filesystem Server",
  "description": "Path-sandboxed filesystem operations server",
  "version": "2.4.0",
  "packages": [
    {
      "registryType": "pypi",
      "identifier": "mcp-workshop-stack",
      "version": "2.4.0",
      "transport": {
        "type": "stdio"
      },
      "runtimeHint": "uv",
      "packageArguments": [
        {
          "type": "positional",
          "value": "serve"
        },
        {
          "type": "positional",
          "value": "filesystem"
        },
        {
          "type": "named",
          "name": "--transport",
          "value": "stdio"
        }
      ]
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "http://127.0.0.1:8090/servers/filesystem/mcp"
    }
  ]
}
