{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-10-17/server.schema.json",
  "name": "io.github.slcc2c/mcp-docker",
  "title": "MCP Docker Server",
  "description": "Docker Engine container, image, volume, and network management server",
  "version": "2.0.0",
  "packages": [
    {
      "registryType": "pypi",
      "identifier": "mcp-workshop-stack",
      "version": "2.0.0",
      "transport": {
        "type": "stdio"
      },
      "runtimeHint": "uv",
      "packageArguments": [
        {
          "type": "positional",
          "value": "serve"
        },
        {
          "type": "positional",
          "value": "docker"
        },
        {
          "type": "named",
          "name": "--transport",
          "value": "stdio"
        }
      ]
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "http://127.0.0.1:8090/servers/docker/mcp"
    }
  ]
}
