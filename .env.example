# Modern MCP Stack Environment Configuration
# Copy to .env and customize for your environment

# --- Gateway ---
MCP_GATEWAY_HOST=127.0.0.1
MCP_GATEWAY_PORT=8090
MCP_LOG_LEVEL=INFO
MCP_LOG_JSON=false
# Auth is disabled on loopback dev unless MCP_AUTH_ENABLED=true or bound to non-loopback (e.g. 0.0.0.0)
MCP_AUTH_ENABLED=false
# MCP_ALLOW_UNAUTHENTICATED_NON_LOOPBACK=false
# GATEWAY_UI_SESSION_TTL_S=43200
# Optional explicit HMAC secret for /ui HttpOnly session cookies (defaults to key derived from client tokens)
# GATEWAY_UI_SESSION_SECRET=
# GATEWAY_EVAL_REGRESSION_THRESHOLD=1.0
# Opt-in write-gated MCP gateway admin tools (upstreams, watchdog restarts, evals, prompt registration)
MCP_GATEWAY_ADMIN_TOOLS_ENABLED=false
# Optional gitignored local overlay for personal external HTTP/stdio MCP proxies (`mcp-stack upstream add`)
# MCP_LOCAL_CONFIG_PATH=config/gateway.local.yaml
# MCP_ENABLED_SERVERS=unity_catalog,mlflow,memory,filesystem,github,docker
MCP_DEFAULT_CLIENT_PROFILE=core
# MCP_PROFILES_JSON={"core":["unity_catalog","mlflow","mlflow_upstream","memory","filesystem","github"]}

# Per-client gateway bearer tokens (used when auth is enabled)
# MCP_ANTIGRAVITY_AUTH_TOKEN=
# MCP_GEMINI_AUTH_TOKEN=
# MCP_CLAUDE_AUTH_TOKEN=
# MCP_CURSOR_AUTH_TOKEN=
# MCP_CODEX_AUTH_TOKEN=
# MCP_OMNIGENT_AUTH_TOKEN=
# MCP_OPENAI_AUTH_TOKEN=
# MCP_DEFAULT_AUTH_TOKEN=

# --- MLflow 3.x (Atelier defaults) ---
MLFLOW_TRACKING_URI=http://localhost:5002
MLFLOW_MCP_URL=http://localhost:9012/mcp
MLFLOW_EXPERIMENT_NAME=mcp-workshop-servers
MLFLOW_TRACING_ENABLED=true
MLFLOW_PROXY_UPSTREAM_MCP=true
# Opt-in write operations (prompt registration, model alias updates)
MLFLOW_ALLOW_MUTATIONS=false
# Optional override; auto-derives uc:<UC_BASE_URL> in OSS mode or databricks-uc in Databricks mode
# MLFLOW_REGISTRY_URI=

# --- Unity Catalog ---
# Supported modes: oss | databricks
UC_MODE=oss
UC_BASE_URL=http://localhost:8080
UC_API_PREFIX=/api/2.1/unity-catalog
# UC_TOKEN=
# UC_DATABRICKS_HOST=
# UC_DATABRICKS_PROFILE=
# Opt-in write operations (create catalog/schema/function, delete function, set model alias)
UC_ALLOW_MUTATIONS=false
UC_ENABLE_FUNCTION_EXECUTION=true
UC_DYNAMIC_FUNCTION_TOOLS=true
# Comma-separated catalog.schema allowlist (or * for all)
UC_FUNCTION_ALLOWLIST=unity.default,workshop.default
UC_ALLOW_OBO_PASSTHROUGH=true
UC_EXECUTION_MODE=sandbox
EXECUTOR_MAX_MEMORY_LIMIT=4096
# Optional comma-separated storage_location=local_dir mapping for OSS UC Volume snapshots
# UC_VOLUME_LOCAL_PREFIX_MAP=file:///home/unitycatalog/etc/data/external/workshop=/Users/spencer/repos/mcp-server/data/uc-volumes

# --- Memory Server (SQLite + FTS5) ---
MEMORY_DB_PATH=data/memory.db
MEMORY_LEGACY_JSON_PATH=data/memory.json
# Optional path or UC Volume mount for snapshot export
# MEMORY_UC_EXPORT_VOLUME=

# --- Filesystem Server ---
ALLOWED_PATHS=/Users/spencer/repos/mcp-server
MAX_FILE_SIZE=10485760

# --- GitHub Server ---
# Supports literal token, env:VAR, or op://<vault>/<item>/<field> when OP_ENABLED=true
# GITHUB_PERSONAL_ACCESS_TOKEN=
# GITHUB_TOKEN=
GITHUB_API_URL=https://api.github.com

# --- Docker Server ---
DOCKER_HOST=unix:///var/run/docker.sock
DOCKER_DEFAULT_MEMORY=2g
DOCKER_DEFAULT_CPUS=1.0

# --- Apple Photos Server (macOS host-only via stdio) ---
# PHOTOS_EXPORT_ROOT=/Users/spencer/Exports/photos-mcp
PHOTOS_TIMEOUT_SECONDS=45

# --- Tier-2 Servers (all read-only / exec-disabled by default; connect lazily) ---
# Optional `docker-compose --profile tier2 up -d postgres redis mongodb neo4j` binds to non-conflicting
# loopback ports: postgres=15432, redis=16379, mongodb=27018, neo4j_bolt=17687 (http=17474)
# TIER2_POSTGRES_PORT=15432
# TIER2_REDIS_PORT=16379
# TIER2_MONGODB_PORT=27018
# TIER2_NEO4J_HTTP_PORT=17474
# TIER2_NEO4J_BOLT_PORT=17687
# POSTGRES_URL=postgresql://postgres:postgres@127.0.0.1:15432/mcp_workshop
POSTGRES_ALLOW_MUTATIONS=false
POSTGRES_MAX_ROWS=1000
POSTGRES_TIMEOUT_S=30

# REDIS_URL=redis://localhost:6379/0
REDIS_ALLOW_MUTATIONS=false
REDIS_MAX_KEYS=500

# MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=mcp_workshop
MONGODB_ALLOW_MUTATIONS=false
MONGODB_MAX_DOCS=500

# NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
# NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
NEO4J_ALLOW_MUTATIONS=false

# KUBECONFIG=~/.kube/config
# K8S_CONTEXT=
K8S_ALLOWED_NAMESPACES=default
K8S_ALLOW_MUTATIONS=false

# JUPYTER_NOTEBOOK_DIR=
JUPYTER_ALLOW_EXECUTION=false
JUPYTER_KERNEL_TIMEOUT_S=30

# XCODE_ALLOWED_ROOTS=
XCODE_ALLOW_MUTATIONS=false
XCODE_TIMEOUT_S=300

# --- Mac mini Antigravity Delegation ---
MAC_MINI_SSH_HOST=spencers-mac-mini
MAC_MINI_REMOTE_BIN=mini-agy-runner
MAC_MINI_SSH_TIMEOUT_S=30
MAC_MINI_ALLOW_MUTATIONS=true

# --- Optional 1Password CLI Secrets ---
OP_ENABLED=false
# service-account fails closed without OP_SERVICE_ACCOUNT_TOKEN; set desktop-cli explicitly to opt in
OP_MODE=service-account
OP_CLI_PATH=op
OP_ALLOWED_VAULTS=AI,Server-Configurations
OP_CACHE_TTL_SECONDS=300
